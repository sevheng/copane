{
  "name": "copane",
  "version": "0.9.11",
  "description": "Terminal code editor with an AI coding CLI (Claude Code by default) in a side pane",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sevheng/copane.git"
  },
  "homepage": "https://github.com/sevheng/copane#readme",
  "bugs": {
    "url": "https://github.com/sevheng/copane/issues"
  },
  "keywords": [
    "editor",
    "terminal",
    "tui",
    "ai",
    "claude",
    "claude-code",
    "bun",
    "opentui"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/main.tsx",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "bun fmt src test",
    "format:check": "bun fmt --check src test",
    "build": "bun build --compile --compile-exec-argv=--smol --minify --bytecode --format=esm --define process.env.NODE_ENV='\"production\"' --define process.env.OPENTUI_LIBC='\"glibc\"' src/main.tsx --outfile dist/copane",
    "install:cli": "sh scripts/install.sh",
    "native": "sh scripts/opentui-native.sh"
  },
  "dependencies": {
    "@opentui/core": "0.7.0",
    "@opentui/keymap": "0.7.0",
    "@opentui/react": "0.7.0",
    "diff": "9.0.0",
    "gemoji": "8.1.0",
    "ignore": "^7.0.12",
    "jsonc-parser": "3.3.1",
    "marked": "18.1.1",
    "react": "^19.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "bun-types": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "@opentui/core@0.7.0": "patches/@opentui%2Fcore@0.7.0.patch"
  }
}
